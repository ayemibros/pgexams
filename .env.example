# Copy this file to .env and fill in real values for this deployment.
# .env is per-deployment/per-client and must never be committed.

# MySQL / MariaDB connection (e.g. XAMPP's MariaDB: root with no password)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cbt_ui
DB_USER=root
DB_PASSWORD=

HOST=0.0.0.0
PORT=8000

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True

TIME_ZONE=Africa/Lagos

# Set ONLINE_MODE=True for a real internet-facing HTTPS deployment (turns on
# secure cookies + HTTPS redirect). Leave False for LAN/offline exam centers.
ONLINE_MODE=False

# Paystack — this client's own merchant account. Get these from
# https://dashboard.paystack.com/#/settings/developers
# Use the sk_test_/pk_test_ keys while testing, sk_live_/pk_live_ in production.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# LOCAL TESTING ONLY: fake "simulate payment" page instead of Paystack.
# Only works with DEBUG=True and no PAYSTACK_SECRET_KEY set.
PAYMENT_SIMULATION=False
